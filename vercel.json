{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": [
    {
      "src": "client",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npm --prefix client run build"
      }
    },
    {
      "src": "api",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
