# ============================================================
# IMAN // BUILD LOG — Environment Configuration Template
# ============================================================
# Copy this file to .env or server/.env and replace placeholders.
# NEVER commit your real .env file with sensitive credentials.

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In development: http://localhost:5173
# In production: https://your-portfolio.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String (Optional for local testing)
# If omitted or invalid, the backend will safely use local JSON file storage
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/iman_portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=10
